# ─── Base de datos (Supabase PostgreSQL) ───────────────────────────────────────
# En Vercel usa la cadena del *pooler* de Supabase (modo transacción, puerto 6543).
# Sustituye TODO este valor por el tuyo (Supabase → Project Settings → Database → Connection string → URI).
DATABASE_URL=postgres://postgres.xxxx:[TU-CONTRASEÑA]@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=5

# URL pública del sitio (canónicas, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=https://cine.libroseller.com

# ─── Video: Mux ────────────────────────────────────────────────────────────────
# Settings → Access Tokens (permisos Mux Video: lectura y escritura)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Settings → Webhooks → URL: https://cine.libroseller.com/api/v1/webhooks/mux  (copiar el «Signing secret»)
MUX_WEBHOOK_SECRET=
# Sólo para contenido restringido (reproducción firmada): Settings → Signing Keys
MUX_SIGNING_KEY_ID=
# la clave privada tal como la entrega Mux (base64)
MUX_SIGNING_PRIVATE_KEY=

# ─── Imágenes y subtítulos ─────────────────────────────────────────────────────
# local = carpeta ./storage (desarrollo) · supabase = Supabase Storage (producción en Vercel)
STORAGE_DRIVER=supabase
SUPABASE_URL=https://xxxx.supabase.co
# secreta: sólo en el servidor
SUPABASE_SERVICE_ROLE_KEY=
# bucket PÚBLICO de sólo lectura para imágenes y .vtt
SUPABASE_STORAGE_BUCKET=media

# ─── Tareas programadas ────────────────────────────────────────────────────────
# Vercel Cron llama a /api/v1/cron/publish con «Authorization: Bearer $CRON_SECRET»
CRON_SECRET=

# ─── Integración futura con CineViral ──────────────────────────────────────────
CINEVIRAL_WEBHOOK_SECRET=

# ─── Primer administrador (sólo para `npm run admin:create`) ───────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
