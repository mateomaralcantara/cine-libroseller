# Puerto HTTP
PORT=3000
# production activa HSTS, cookies Secure y exige HTTPS en webhooks salientes
NODE_ENV=production
# Ruta de la base SQLite (por defecto ./data/cine.db)
DB_FILE=/var/lib/cine-libroseller/cine.db
# 1 si corre detrás de Nginx/Caddy/Cloudflare (para IP real y protocolo)
TRUST_PROXY=1
# Orígenes adicionales aceptados para peticiones que modifican datos (separados por coma)
ALLOWED_ORIGINS=https://cine.libroseller.com
# Administrador inicial (sólo se usa si la base está vacía). Mín. 10 caracteres, letras y números.
ADMIN_EMAIL=admin@cine.libroseller.com
ADMIN_PASSWORD=
